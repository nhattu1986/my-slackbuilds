From fb5dc46317953fc136eb276e492fd19c6f9b5e1c Mon Sep 17 00:00:00 2001
From: koplo199 <85577251+koplo199@users.noreply.github.com>
Date: Mon, 24 Apr 2023 18:54:57 +0000
Subject: [PATCH] fix: Support newer vkd3d-proton

---
 bottles/backend/dlls/dll.py      | 26 +++++++++-----------------
 bottles/backend/dlls/vkd3d.py    |  6 ++++--
 bottles/backend/wine/executor.py |  2 +-
 3 files changed, 14 insertions(+), 20 deletions(-)

diff --git a/bottles/backend/dlls/dll.py b/bottles/backend/dlls/dll.py
index 24f06718ef..01de48d944 100644
--- a/bottles/backend/dlls/dll.py
+++ b/bottles/backend/dlls/dll.py
@@ -20,6 +20,7 @@
 from glob import glob
 from typing import NewType
 from abc import abstractmethod
+from copy import deepcopy
 
 from bottles.backend.logger import Logger
 from bottles.backend.models.config import BottleConfig
@@ -34,6 +35,7 @@
 class DLLComponent:
     base_path: str = None
     dlls: dict = {}
+    checked_dlls: dict = {}
     version: str = None
 
     def __init__(self, version: str):
@@ -47,7 +49,7 @@ def get_base_path(version: str):
         pass
 
     def check(self):
-        found = self.dlls.copy()
+        found = deepcopy(self.dlls)
 
         if None in self.dlls:
             logging.error(f"DLL(s) \"{self.dlls[None]}\" path haven't been found, ignoring...")
@@ -61,22 +63,12 @@ def check(self):
             for dll in self.dlls[path]:
                 _dll = os.path.join(_path, dll)
                 if not os.path.exists(_dll):
-                    try:
-                        del found[path][dll]
-                    except TypeError:
-                        # WORKAROUND: I'm not able to find what is causing this
-                        #          TypeError, I've tested with some different
-                        #          setups and I've never been able to reproduce
-                        #          it, so I'm just providing a workaround for
-                        #          not breaking the app. Thiw workaround removes
-                        #          the path from the list of found dlls as it
-                        #          seems to empty in some cases.
-                        del found[path]
+                    found[path].remove(dll)
 
         if len(found) == 0:
             return False
 
-        self.dlls = found
+        self.checked_dlls = found
         return True
 
     def install(self, config: BottleConfig, overrides_only: bool = False, exclude=None):
diff --git a/bottles/backend/dlls/vkd3d.py b/bottles/backend/dlls/vkd3d.py
index 7a9e011fb1..1765af32d1 100644
--- a/bottles/backend/dlls/vkd3d.py
+++ b/bottles/backend/dlls/vkd3d.py
@@ -22,10 +22,12 @@
 class VKD3DComponent(DLLComponent):
     dlls = {
         "x86": [
-            "d3d12.dll"
+            "d3d12.dll",
+            "d3d12core.dll"
         ],
         "x64": [
-            "d3d12.dll"
+            "d3d12.dll",
+            "d3d12core.dll"
         ]
     }
 
